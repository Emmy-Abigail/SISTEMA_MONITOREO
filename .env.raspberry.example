# Estación de cámara en la Raspberry Pi 5. Copiar como .env (el instalador lo hace).
RAILWAY_URL=https://sistemamonitoreo-production-8883a6d5.up.railway.app
# Obligatoria: como servicio no hay teclado para escribirla al arrancar.
ALERTA_KEY=

# Cámara CSI: auto usa Picamera2 si hay una cámara conectada.
CAMARA_FUENTE=auto
# Ajuste de libcamera. auto = imx219_noir.json (cámara NoIR V2). ninguno = de fábrica.
CAMARA_TUNING=auto
# 0, 90, 180 o 270 si la cámara quedó montada girada.
CAMARA_ROTAR=0
# si = analizar en escala de grises (la NoIR da colores rosados de día).
CAMARA_GRIS=no
