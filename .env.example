# ÑAWI APU · variables de entorno
# Copia este archivo como .env (local) o configúralas en Railway → Variables.
# Nunca subas el .env real a GitHub.

# --- Clave compartida entre el servidor, la cámara y el dashboard ---
ALERTA_KEY=una_clave_larga_y_aleatoria

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números que pueden usar el bot y reciben alertas, separados por comas.
# Vacío = cualquiera que escriba al bot (solo para pruebas).
WHATSAPP_AUTORIZADOS=+51900000000,+51911111111
# Opcional: plantilla aprobada (Content SID "HX…") para alertas fuera de la ventana de 24 h.
TWILIO_PLANTILLA_ALERTA=
# Opcional: URL exacta del webhook si la firma de Twilio no coincide detrás del proxy.
TWILIO_WEBHOOK_URL=

# --- Verificación con Gemini (Google AI Studio) ---
GEMINI_API_KEY=tu_clave_de_gemini
# Opcional: modelo (por defecto gemini-3.5-flash-lite).
GEMINI_MODEL=
# 1 = acepta animales mostrados en pantalla o celular (demostraciones). 0 = solo reales.
GEMINI_ACEPTAR_PANTALLAS=1

# --- Dashboard ---
DASHBOARD_URL=https://sistemamonitoreo-production-8883a6d5.up.railway.app/

# --- Cámara (agente en la PC o la Raspberry Pi) ---
RAILWAY_URL=https://sistemamonitoreo-production-8883a6d5.up.railway.app
